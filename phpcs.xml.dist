<?xml version="1.0"?>
<ruleset name="NR EnrichCore">
    <description>PSR-12 for the bundle's PHP sources.</description>

    <file>src</file>
    <file>tests</file>

    <!--
        Only PHP files. Without this, phpcs also parses
        src/Resources/public/js/nr-enrich-core.js as PHP and reports a
        dozen PSR-12 violations against JavaScript.
    -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="PSR12"/>

</ruleset>
